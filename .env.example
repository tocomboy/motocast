# Browser-safe values. Restrict the Kakao JavaScript key to the deployed domains.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
KAKAO_REST_API_KEY=
KMA_APIHUB_KEY=
ALLOWED_ORIGINS=http://localhost:3000

# Internal hard stops. Choose values below the provider's current free quota.
# The functions refuse external calls when a limit is missing or reached.
KAKAO_CURRENT_DAILY_LIMIT=1000
KAKAO_FUTURE_DAILY_LIMIT=500
KMA_DAILY_LIMIT=1000
